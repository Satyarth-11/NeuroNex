# Neo4j connection (REQUIRED: must be set from environment/.env)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neuronex_demo

# SQLite (change to postgresql+asyncpg://... for production)
DATABASE_URL=sqlite+aiosqlite:///./neuronex.db

# NLP model (swap to a transformer model name when available)
SPACY_MODEL=en_core_web_sm

# Entity resolution thresholds (0.0 – 1.0)
RESOLUTION_AUTO_MERGE_THRESHOLD=0.92
RESOLUTION_REVIEW_THRESHOLD=0.72

# CORS origins (JSON list)
CORS_ORIGINS=["http://localhost:3001","http://localhost:3000"]

# Debug mode
DEBUG=false

# Synthetic data random seed (keep fixed for reproducibility)
SYNTHETIC_SEED=42
